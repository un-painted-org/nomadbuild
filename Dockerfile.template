# Use the official ESP-IDF image matching the version used in ESP-Miner devcontainer
# Reference: https://github.com/bitaxeorg/ESP-Miner/blob/master/.devcontainer/Dockerfile
# BUT with a sha256 hash to make sure it does not change
FROM espressif/idf@${BASE_IMAGE_DIGEST} AS builder

# Set build arguments for all versions (populated from config.yaml)
ARG TZ=${TZ}
ARG LC_ALL=${LC_ALL}
ARG LANG=${LANG}
ARG PYTHONHASHSEED=${PYTHONHASHSEED}

# APT package versions
ARG CA_CERTIFICATES=${CA_CERTIFICATES}
ARG CURL=${CURL}
ARG GNUPG=${GNUPG}
ARG PANDOC=${PANDOC}
ARG PERL=${PERL}
ARG PYTHON3_PIP=${PYTHON3_PIP}
ARG PYTHON3_VENV=${PYTHON3_VENV}
ARG NODEJS=${NODEJS}

# Toolchain versions
ARG GCC=${GCC}
ARG CMAKE=${CMAKE}
ARG OBJCOPY=${OBJCOPY}
ARG PYTHON3=${PYTHON3}

# Python package versions
ARG FLASK=${FLASK}
ARG FLASK_SOCKETIO=${FLASK_SOCKETIO}
ARG PYTEST=${PYTEST}
ARG PYTEST_MOCK=${PYTEST_MOCK}
ARG PYTEST_SUGAR=${PYTEST_SUGAR}
ARG REQUESTS=${REQUESTS}
ARG WERKZEUG=${WERKZEUG}
ARG JINJA2=${JINJA2}
ARG ITSDANGEROUS=${ITSDANGEROUS}
ARG BLINKER=${BLINKER}
ARG PYTHON_SOCKETIO=${PYTHON_SOCKETIO}
ARG PYTHON_ENGINEIO=${PYTHON_ENGINEIO}
ARG BIDICT=${BIDICT}
ARG SIMPLE_WEBSOCKET=${SIMPLE_WEBSOCKET}
ARG H11=${H11}
ARG WSPROTO=${WSPROTO}
ARG PYYAML=${PYYAML}
ARG ESP_IDF_MONITOR=${ESP_IDF_MONITOR}
ARG IDF_COMPONENT_MANAGER=${IDF_COMPONENT_MANAGER}
ARG KCONFIGLIB=${KCONFIGLIB}

# Set environment variables to non-interactive (avoids prompts during apt-get)
ENV DEBIAN_FRONTEND=noninteractive

# Reproducibility: guarantee consistent locale, timezone and hash seed
ENV TZ=${TZ} \
    LC_ALL=${LC_ALL} \
    LANG=${LANG} \
    PYTHONHASHSEED=${PYTHONHASHSEED}

# Install Node.js and required packages in a single layer to reduce image size
USER root
RUN mkdir -p /etc/apt/preferences.d /etc/apt/keyrings /container_only/config && \
    # Create apt preferences files for pinning
    echo "Package: ca-certificates\nPin: version ${CA_CERTIFICATES}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-ca-certificates && \
    echo "Package: curl\nPin: version ${CURL}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-curl && \
    echo "Package: gnupg\nPin: version ${GNUPG}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-gnupg && \
    echo "Package: pandoc\nPin: version ${PANDOC}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-pandoc && \
    echo "Package: perl\nPin: version ${PERL}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-perl && \
    echo "Package: python3-pip\nPin: version ${PYTHON3_PIP}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-python3-pip && \
    echo "Package: python3-venv\nPin: version ${PYTHON3_VENV}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-python3-venv && \
    echo "Package: nodejs\nPin: version ${NODEJS}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-nodejs && \
    # Create pin configuration files for verification
    echo "# Pin exact versions of CLI tools for reproducible builds" > /container_only/config/toolchain_pins.conf && \
    echo "gcc=${GCC}" >> /container_only/config/toolchain_pins.conf && \
    echo "cmake=${CMAKE}" >> /container_only/config/toolchain_pins.conf && \
    echo "objcopy=${OBJCOPY}" >> /container_only/config/toolchain_pins.conf && \
    echo "python3=${PYTHON3}" >> /container_only/config/toolchain_pins.conf && \
    echo "base_image=${BASE_IMAGE_DIGEST}" >> /container_only/config/toolchain_pins.conf && \
    # Create apt_pins.conf
    echo "# APT packages with pinned versions" > /container_only/config/apt_pins.conf && \
    echo "ca-certificates=${CA_CERTIFICATES}" >> /container_only/config/apt_pins.conf && \
    echo "curl=${CURL}" >> /container_only/config/apt_pins.conf && \
    echo "gnupg=${GNUPG}" >> /container_only/config/apt_pins.conf && \
    echo "pandoc=${PANDOC}" >> /container_only/config/apt_pins.conf && \
    echo "perl=${PERL}" >> /container_only/config/apt_pins.conf && \
    echo "python3-pip=${PYTHON3_PIP}" >> /container_only/config/apt_pins.conf && \
    echo "python3-venv=${PYTHON3_VENV}" >> /container_only/config/apt_pins.conf && \
    echo "nodejs=${NODEJS}" >> /container_only/config/apt_pins.conf && \
    # Install packages
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        pandoc \
        perl \
        python3-pip \
        python3-venv && \
    # Setup NodeSource repo
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    # Install nodejs
    apt-get install -y nodejs && \
    # Aggressive cleanup to reduce image size
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    # Remove documentation, man pages, and other non-essential files
    rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* && \
    # Remove apt cache
    rm -rf /var/cache/apt/* && \
    # Remove temporary files
    rm -rf /tmp/* /var/tmp/*

# Set up a virtual environment for Python dependencies
ENV VENV_PATH=/opt/venv
RUN python3 -m venv $VENV_PATH && \
    # Install Python dependencies in a single layer with no cache
    $VENV_PATH/bin/pip install --no-cache-dir \
    flask==${FLASK} flask-socketio==${FLASK_SOCKETIO} pytest==${PYTEST} pytest-mock==${PYTEST_MOCK} pytest-sugar==${PYTEST_SUGAR} \
    requests==${REQUESTS} werkzeug==${WERKZEUG} jinja2==${JINJA2} itsdangerous==${ITSDANGEROUS} \
    blinker==${BLINKER} python-socketio==${PYTHON_SOCKETIO} python-engineio==${PYTHON_ENGINEIO} \
    bidict==${BIDICT} simple-websocket==${SIMPLE_WEBSOCKET} h11==${H11} wsproto==${WSPROTO} \
    pyyaml==${PYYAML} esp-idf-monitor==${ESP_IDF_MONITOR} \
    idf-component-manager==${IDF_COMPONENT_MANAGER} \
    kconfiglib==${KCONFIGLIB} && \
    # Create symlinks for Python executables
    ln -sf $VENV_PATH/bin/python /usr/local/bin/python && \
    ln -sf $VENV_PATH/bin/python3 /usr/local/bin/python3 && \
    ln -sf $VENV_PATH/bin/pip /usr/local/bin/pip && \
    ln -sf $VENV_PATH/bin/pip3 /usr/local/bin/pip3 && \
    ln -sf $VENV_PATH/bin/pytest /usr/local/bin/pytest && \
    # Optimize Python virtual environment
    find $VENV_PATH -name __pycache__ -type d -exec rm -rf {} +; 2>/dev/null || true && \
    find $VENV_PATH -name "*.pyc" -delete && \
    find $VENV_PATH -name "*.pyo" -delete && \
    find $VENV_PATH -name "*.so" -exec strip --strip-unneeded {} \; 2>/dev/null || true

# Setup application
WORKDIR /app

# Copy only what's needed for the application
COPY src/ /app/src/
COPY scripts/ /app/scripts/
COPY docs/ /app/docs/

# Create necessary directories and prepare application in a single layer
RUN mkdir -p /app/src/web_static/vendor/js /app/src/web_static/img /app/src/web_static/version /app/src/web_static/fonts /firmware && \
    # Make all shell scripts executable
    find /app/scripts -name "*.sh" -exec chmod +x {} \; && \
    # Download vendor libraries
    /app/scripts/download_vendors.sh && \
    # Update version information
    /app/scripts/update_version.sh && \
    # Remove unnecessary files
    find /app -name "__pycache__" -type d -exec rm -rf {} +; 2>/dev/null || true && \
    find /app -name "*.pyc" -delete && \
    find /app -name "*.pyo" -delete && \
    # Strip Python shared objects to reduce size
    find /app -name "*.so" -exec strip --strip-unneeded {} \; 2>/dev/null || true

# Copy tests
COPY src/tests/ /app/src/tests/

# Set environment variable for config directory
ENV NOMADBUILD_CONFIG_DIR=/container_only/config

# Verify pinned package versions
RUN /app/scripts/verify_pinned_versions.sh

# Start a new stage for the runtime image
# Re-declare ARG for the new stage
ARG BASE_IMAGE_DIGEST
FROM espressif/idf@${BASE_IMAGE_DIGEST} AS runtime

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=${TZ} \
    LC_ALL=${LC_ALL} \
    LANG=${LANG} \
    PYTHONHASHSEED=${PYTHONHASHSEED} \
    VENV_PATH=/opt/venv \
    NOMADBUILD_CONFIG_DIR=/container_only/config

# Install runtime dependencies with version pinning
USER root
RUN mkdir -p /etc/apt/preferences.d /etc/apt/keyrings /container_only/config && \
    # Create apt preferences files for pinning
    echo "Package: ca-certificates\nPin: version ${CA_CERTIFICATES}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-ca-certificates && \
    echo "Package: curl\nPin: version ${CURL}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-curl && \
    echo "Package: gnupg\nPin: version ${GNUPG}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-gnupg && \
    echo "Package: pandoc\nPin: version ${PANDOC}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-pandoc && \
    echo "Package: perl\nPin: version ${PERL}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-perl && \
    echo "Package: python3-pip\nPin: version ${PYTHON3_PIP}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-python3-pip && \
    echo "Package: python3-venv\nPin: version ${PYTHON3_VENV}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-python3-venv && \
    echo "Package: nodejs\nPin: version ${NODEJS}\nPin-Priority: 1001" > /etc/apt/preferences.d/pin-nodejs && \
    # Install packages
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        pandoc \
        perl \
        python3-pip \
        python3-venv && \
    # Setup NodeSource repo
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && \
    # Install nodejs
    apt-get install -y nodejs && \
    # Aggressive cleanup
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /usr/share/doc/* /usr/share/man/* /usr/share/info/* && \
    rm -rf /var/cache/apt/* && \
    rm -rf /tmp/* /var/tmp/* && \
    # Create necessary directories
    mkdir -p /container_only/config /firmware /app && \
    # Create pin configuration files for verification
    echo "# Pin exact versions of CLI tools for reproducible builds" > /container_only/config/toolchain_pins.conf && \
    echo "gcc=${GCC}" >> /container_only/config/toolchain_pins.conf && \
    echo "cmake=${CMAKE}" >> /container_only/config/toolchain_pins.conf && \
    echo "objcopy=${OBJCOPY}" >> /container_only/config/toolchain_pins.conf && \
    echo "python3=${PYTHON3}" >> /container_only/config/toolchain_pins.conf && \
    echo "base_image=${BASE_IMAGE_DIGEST}" >> /container_only/config/toolchain_pins.conf && \
    # Create apt_pins.conf
    echo "# APT packages with pinned versions" > /container_only/config/apt_pins.conf && \
    echo "ca-certificates=${CA_CERTIFICATES}" >> /container_only/config/apt_pins.conf && \
    echo "curl=${CURL}" >> /container_only/config/apt_pins.conf && \
    echo "gnupg=${GNUPG}" >> /container_only/config/apt_pins.conf && \
    echo "pandoc=${PANDOC}" >> /container_only/config/apt_pins.conf && \
    echo "perl=${PERL}" >> /container_only/config/apt_pins.conf && \
    echo "python3-pip=${PYTHON3_PIP}" >> /container_only/config/apt_pins.conf && \
    echo "python3-venv=${PYTHON3_VENV}" >> /container_only/config/apt_pins.conf && \
    echo "nodejs=${NODEJS}" >> /container_only/config/apt_pins.conf

# Copy Python virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# Create symlinks for Python executables
RUN ln -sf $VENV_PATH/bin/python /usr/local/bin/python && \
    ln -sf $VENV_PATH/bin/python3 /usr/local/bin/python3 && \
    ln -sf $VENV_PATH/bin/pip /usr/local/bin/pip && \
    ln -sf $VENV_PATH/bin/pip3 /usr/local/bin/pip3 && \
    ln -sf $VENV_PATH/bin/pytest /usr/local/bin/pytest

# Copy application files from builder
COPY --from=builder /app /app
COPY --from=builder /container_only /container_only

# Set working directory
WORKDIR /app

# Make all shell scripts executable in the runtime stage
RUN find /app/scripts -name "*.sh" -exec chmod +x {} \;

# Define the volume mount point and expose port
VOLUME /firmware
EXPOSE 9090

# Set the entrypoint
ENTRYPOINT ["/app/scripts/entrypoint_wrapper.sh"]
